# Entornos Virtuales
.venv/
venv/
env/
ENV/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*$py.class

# Archivos de Entorno y Secretos (Seguridad Crítica)
.env
.env.local
.env.*
secrets.toml
*.pem
*.key

# Modelos ML generados (Se generan on-the-fly, no subir)
*.joblib
*.pkl
*.pth
*.pt

# Modelos 3D propietarios (Para que no te roben los assets)
*.glb
*.gltf
*.obj
*.fbx
# Solo la carpeta assets/ de la raiz (modelos 3D). Las carpetas assets/ de los
# proyectos web de renovaciones-de-web/ si deben versionarse.
/assets/

# Archivos del SO
.DS_Store
Thumbs.db
